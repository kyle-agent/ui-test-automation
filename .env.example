# ---- 콘솔 (필수) ----
# 회귀 대상 환경. e=Enterprise. 리전 호스트까지 포함한다.
CONSOLE_URL=https://console.kr-west1.e.samsungsdscloud.com
# 사용할 세션 종류: root | iam  → recordings/session-<SESSION>.json 을 storageState 로 쓴다.
SESSION=root
# 권장: `npm run auth:login -- --keep-open` 으로 띄워 둔 로그인 브라우저에 붙는다. 콘솔은 창을 닫거나 시간이 지나면
# 세션을 무효화하므로(SSO 까지 로그아웃), 쿠키 파일 재생보다 살아 있는 브라우저에 붙는 쪽이 안전하다.
PW_CDP_URL=http://127.0.0.1:9222

# ---- 실행 옵션 ----
# destructive 태그 시나리오(과금 리소스 생성/삭제)까지 실행하려면 1. 기본은 제외.
# RUN_DESTRUCTIVE=1
# 워커 수 (기본: CI 2, 로컬 4)
# PW_WORKERS=2
# 브라우저 다운로드가 막힌 사내 PC: 설치된 Edge/Chrome 을 그대로 쓴다 (npx playwright install 불필요)
# PW_CHANNEL=msedge

# ---- Jev / OpenRouter (기록·치유 단계에서만 필요, 회귀 실행에는 불필요) ----
# 모두 같은 OpenRouter 키를 넣는다. 키는 코드/LLM 프롬프트/트레이스에 절대 기록되지 않는다.
OPENROUTER_API_KEY=
TYPESAFE_API_KEY=
TYPESAFE_MODEL=typesafe/jev-1.13
TYPESAFE_API_URL=https://openrouter.ai/api/alpha/decisions
# TYPE_TEXT 값 생성용 소형 모델 (시나리오 vars 로 값을 못 정할 때만 호출)
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
